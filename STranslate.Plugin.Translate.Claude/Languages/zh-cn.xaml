<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="STranslate_Plugin_Translate_Claude_Url">接口</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Claude_Url_Description">配置 Claude API 服务地址&#x0a;接口API地址不填写Path内容则自动填充 /v1/messages&#x0a;如Claude接口地址为 https://api.anthropic.com/v1/messages 其中 Path 为 /v1/messages</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Claude_ApiKey">密钥</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Claude_ApiKey_Placeholder">请输入密钥</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Claude_ApiKey_Description">输入您的 Claude API 密钥</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Claude_Model">请选择模型</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Claude_Prompt_Header">提示词配置</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Claude_Prompt_Description">选择或编辑翻译使用的提示词模板</sys:String>
