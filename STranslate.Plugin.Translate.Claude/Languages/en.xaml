<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="STranslate_Plugin_Translate_Claude_Url">Url</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Claude_Url_Description">Configure the Claude API service address.&#x0a;If the Path is not filled in, it will be automatically populated with /v1/messages.&#x0a;For example, for the Claude API address https://api.anthropic.com/v1/messages, the Path is /v1/messages.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Claude_ApiKey">ApiKey</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Claude_ApiKey_Placeholder">Please enter your apiKey</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Claude_ApiKey_Description">Enter your Claude API key</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Claude_Model">Select a model</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Claude_Prompt_Header">Prompt Configuration</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Claude_Prompt_Description">Select or edit the prompt template for translation</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Claude_Prompt_Placeholder">Select a prompt template</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Claude_EditPrompt_ToolTip">Edit Prompt</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Claude_EditPrompt_Content">Edit</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Claude_Temperature">Temperature Control</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Claude_Temperature_Description">Controls the randomness of the model's output</sys:String>

</ResourceDictionary>